---
// Pinned main button, shown only in the mobile-short variant.
---

<div class="sticky-cta">
  <button type="button" class="btn btn-primary" data-reshape="cta" data-action="join"><span data-swap-text>Join early access</span></button>
</div>

<style>
  .sticky-cta {
    display: none;
  }
  :global(html[data-shape='mobile']) .sticky-cta {
    display: block;
    position: fixed;
    inset: auto 0 0 0;
    z-index: 44;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom));
    background: var(--paper);
    border-top: 1px solid var(--hairline);
  }
  .sticky-cta .btn {
    width: 100%;
  }
  @media (min-width: 761px) {
    :global(html[data-shape='mobile']) .sticky-cta {
      inset: auto 24px 24px auto;
      padding: 0;
      background: none;
      border: 0;
    }
  }
</style>
