---
import Frame from '../Frame.astro';
import SectionHead from '../SectionHead.astro';
import u1 from '../../assets/images/usecase-1.jpg';
import u2 from '../../assets/images/usecase-2.jpg';
import u3 from '../../assets/images/usecase-3.jpg';

const cases = [
  {
    name: 'Landing pages',
    img: u1,
    alt: 'Three colleagues laughing together over laptops at a cafe table',
    text: 'Show builders the snippet, buyers the plan and careful readers the reasoning, from the same campaign link.',
    slide: 'left',
  },
  {
    name: 'Pricing pages',
    img: u2,
    alt: 'A group of young colleagues talking around a table with laptops',
    text: 'Bring the comparison forward for people who are comparing. Prices themselves never change.',
    slide: 'up',
  },
  {
    name: 'Docs home pages',
    img: u3,
    alt: 'Developers looking at code on a monitor together',
    text: 'Put the quick start first for people in a hurry and the concepts first for people learning.',
    slide: 'right',
  },
] as const;
---

<section class="section" id="use-cases" aria-labelledby="cases-title">
  <div class="container">
    <SectionHead name="Use cases" />
    <h2 id="cases-title" class="h-section">Where it helps, <span class="accent">and where it shouldn't.</span></h2>
    <ul class="cases">
      {
        cases.map((c) => (
          <li class="card case" data-slide={c.slide}>
            <Frame src={c.img} alt={c.alt} ratio="16 / 10" sizes="(max-width: 860px) 100vw, 380px" widths={[360, 560, 760]} />
            <h3 class="h-card">{c.name}</h3>
            <div class="collapsible">
              <p class="clip">{c.text}</p>
              <button type="button" class="more-btn" aria-expanded="false">Read more</button>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="not-for" data-slide="up">
      <span class="label label-sm"><span class="c">Not for</span></span>
      Not for checkout, legal or medical pages. Those should be the same for everyone.
    </p>
  </div>
</section>

<style>
  .h-section {
    margin-bottom: 40px;
  }
  .cases {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1.15fr 1fr 1fr;
    gap: 24px;
  }
  .case {
    padding: 16px;
    display: grid;
    gap: 16px;
    align-content: start;
  }
  .case .frame {
    padding: 0;
    border: 0;
  }
  .case p {
    margin: 0;
  }
  .not-for {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    margin: 32px 0 0;
    padding: 16px 0;
    border-block: 1px solid var(--hairline);
    max-width: none;
    font-weight: 500;
  }
  @media (max-width: 860px) {
    .cases {
      grid-template-columns: 1fr;
    }
  }
</style>
