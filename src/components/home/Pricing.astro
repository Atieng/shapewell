---
import { Icon } from 'astro-icon/components';
import SectionHead from '../SectionHead.astro';

const plans = [
  {
    name: 'Starter',
    monthly: 0,
    yearly: 0,
    per: { monthly: 'free forever', yearly: 'free forever' },
    for: 'For trying it on one site.',
    features: ['1 site', '10k visits a month', 'The studio', 'No card needed'],
    cta: 'Start free',
    primary: false,
    slide: 'left',
  },
  {
    name: 'Growth',
    monthly: 19,
    yearly: 15.2,
    per: { monthly: 'per month', yearly: 'per month, billed yearly' },
    for: 'For teams running real experiments.',
    features: ['5 sites', '100k visits a month', 'Saved runs export', 'Priority email'],
    cta: 'Join early access',
    primary: true,
    slide: 'up',
  },
  {
    name: 'Scale',
    monthly: null,
    yearly: null,
    per: { monthly: 'talk to us', yearly: 'talk to us' },
    for: 'For many sites and stricter rules.',
    features: ['Unlimited sites', 'SSO', 'SLA'],
    cta: 'Talk to us',
    primary: false,
    slide: 'right',
  },
] as const;
const fmt = (n: number) => `$${Number.isInteger(n) ? n : n.toFixed(2)}`;
---

<section class="section" id="pricing" aria-labelledby="pricing-title" data-signal="pricing">
  <div class="container">
    <SectionHead name="Pricing" />
    <div class="pricing-head">
      <h2 id="pricing-title" class="h-section">Pay for results, <span class="accent">not page views.</span></h2>
      <div class="billing" data-billing role="group" aria-label="Billing period">
        <button type="button" data-period="monthly" aria-pressed="true">Monthly</button>
        <button type="button" data-period="yearly" aria-pressed="false">Yearly <span class="mono save">-20 %</span></button>
      </div>
    </div>

    <ul class="plans" data-flip>
      {
        plans.map((p) => (
          <li class:list={['plan', p.primary && 'plan-main']} data-slide={p.slide} data-flip>
            <span class="label label-sm">
              <span class="c">{p.name}</span>
            </span>
            <p class="price">
              {p.monthly === null ? (
                <span class="price-num">Custom</span>
              ) : (
                <span class="price-num" data-price data-monthly={p.monthly} data-yearly={p.yearly}>
                  {fmt(p.monthly)}
                </span>
              )}
              <span class="per muted" data-per data-monthly={p.per.monthly} data-yearly={p.per.yearly}>
                {p.per.monthly}
              </span>
            </p>
            <p class="for">{p.for}</p>
            <ul class="features">
              {p.features.map((f) => (
                <li>
                  <Icon name="lucide:check" aria-hidden="true" />
                  {f}
                </li>
              ))}
            </ul>
            <a class:list={['btn', p.primary && 'btn-primary']} href="#early-access">
              {p.cta}
            </a>
          </li>
        ))
      }
    </ul>

    <details class="compare" data-open-for="buyer" data-flip>
      <summary>Compare plans</summary>
      <div class="table-wrap">
        <table>
          <caption class="sr-only">Plan comparison</caption>
          <thead>
            <tr><th scope="col">Feature</th><th scope="col">Starter</th><th scope="col">Growth</th><th scope="col">Scale</th></tr>
          </thead>
          <tbody>
            <tr><th scope="row">Sites</th><td>1</td><td>5</td><td>Unlimited</td></tr>
            <tr><th scope="row">Visits a month</th><td>10k</td><td>100k</td><td>Custom</td></tr>
            <tr><th scope="row">Studio and reasons</th><td>Yes</td><td>Yes</td><td>Yes</td></tr>
            <tr><th scope="row">Saved runs export</th><td>No</td><td>Yes</td><td>Yes</td></tr>
            <tr><th scope="row">SSO and SLA</th><td>No</td><td>No</td><td>Yes</td></tr>
            <tr><th scope="row">Support</th><td>Docs</td><td>Priority email</td><td>Named contact</td></tr>
          </tbody>
        </table>
      </div>
    </details>
    <p class="pricing-note muted">Shapewell is in early access. These are the planned prices; nobody is billed today.</p>
  </div>
</section>

<style>
  .pricing-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 40px;
  }
  .billing {
    display: inline-flex;
    border: 1px solid var(--graphite);
    border-radius: 2px;
  }
  .billing button {
    min-height: 44px;
    padding: 8px 16px;
    background: none;
    border: 0;
    font-weight: 600;
    font-size: 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .billing button[aria-pressed='true'] {
    background: var(--graphite);
    color: var(--paper);
  }
  .save {
    font-size: 10px;
    color: var(--cobalt);
  }
  .billing button[aria-pressed='true'] .save {
    color: #aab6ff;
  }
  .plans {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    align-items: stretch;
  }
  .plan {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: 2px;
    transition: padding 0.4s ease;
  }
  .plan-main {
    border: 1px solid var(--graphite);
    border-top: 3px solid var(--cobalt);
  }
  .price {
    display: grid;
    gap: 4px;
    margin: 0;
  }
  .price-num {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 48px;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .per {
    font-size: 14px;
  }
  .for {
    margin: 0;
  }
  .features {
    list-style: none;
    margin: 0;
    padding: 16px 0 0;
    border-top: 1px solid var(--hairline);
    display: grid;
    gap: 8px;
    flex: 1;
  }
  .features li {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
  }
  .features svg {
    width: 16px;
    height: 16px;
    color: var(--cobalt);
  }
  :global(html[data-shape='buyer']) .plan {
    padding: 40px 32px;
  }
  :global(html[data-shape='buyer']) .price-num {
    font-size: 64px;
  }
  .compare {
    margin-top: 24px;
    border: 1px solid var(--hairline);
    background: var(--white);
  }
  .compare summary {
    padding: 16px 20px;
    font-weight: 600;
    cursor: pointer;
  }
  .table-wrap {
    overflow-x: auto;
    border-top: 1px solid var(--hairline);
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    min-width: 520px;
  }
  th,
  td {
    text-align: left;
    padding: 12px 20px;
    border-bottom: 1px solid var(--hairline);
  }
  thead th {
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--slate);
  }
  tbody th {
    font-weight: 500;
  }
  tbody tr:last-child > * {
    border-bottom: 0;
  }
  .pricing-note {
    margin: 20px 0 0;
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .plans {
      grid-template-columns: 1fr;
    }
  }
</style>
