---
import SectionHead from '../SectionHead.astro';
---

<section class="section pp" id="pricing-preview" aria-labelledby="pp-title" data-signal="pricing">
  <div class="container">
    <SectionHead name="Pricing preview" />
    <div class="pp-grid">
      <h2 id="pp-title" class="h-section">Free for your <span class="accent">first site.</span></h2>
      <ul class="pp-plans">
        <li><span class="mono">Starter</span><strong>$0</strong><span>1 site, 10k visits a month</span></li>
        <li><span class="mono">Growth</span><strong>$19<small>/mo</small></strong><span>5 sites, 100k visits a month</span></li>
        <li><span class="mono">Scale</span><strong>Custom</strong><span>Unlimited sites, SSO, SLA</span></li>
      </ul>
      <a class="btn btn-primary" href="#pricing">See full pricing</a>
    </div>
  </div>
</section>

<style>
  .pp-grid {
    display: grid;
    grid-template-columns: 1fr 2fr auto;
    gap: 32px;
    align-items: center;
  }
  .pp-plans {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: 1px solid var(--hairline);
    background: var(--white);
  }
  .pp-plans li {
    display: grid;
    gap: 6px;
    padding: 18px;
    border-right: 1px solid var(--hairline);
    font-size: 14px;
  }
  .pp-plans li:last-child {
    border-right: 0;
  }
  .pp-plans .mono {
    font-size: 11px;
    color: var(--cobalt);
  }
  .pp-plans strong {
    font-family: var(--f-head);
    font-size: 30px;
    line-height: 1;
  }
  .pp-plans small {
    font-family: var(--f-body);
    font-size: 14px;
    font-weight: 500;
  }
  @media (max-width: 900px) {
    .pp-grid {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .pp-plans {
      grid-template-columns: 1fr;
      width: 100%;
    }
    .pp-plans li {
      border-right: 0;
      border-bottom: 1px solid var(--hairline);
    }
  }
</style>
