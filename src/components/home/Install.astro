---
import { Icon } from 'astro-icon/components';
import SectionHead from '../SectionHead.astro';

const tabs = [
  {
    id: 'html',
    name: 'HTML',
    code: `<script src="https://cdn.shapewell.dev/v1.js" defer\n  data-site="your-site-id"></script>`,
  },
  {
    id: 'astro',
    name: 'Astro',
    code: `<!-- src/layouts/Base.astro, inside <head> -->\n<script is:inline src="https://cdn.shapewell.dev/v1.js" defer\n  data-site="your-site-id"></script>`,
  },
  {
    id: 'next',
    name: 'Next.js',
    code: `// app/layout.tsx\nimport Script from 'next/script';\n\n<Script src="https://cdn.shapewell.dev/v1.js"\n  data-site="your-site-id" strategy="afterInteractive" />`,
  },
];
---

<section class="section" id="install" aria-labelledby="install-title">
  <div class="container grid-12 install">
    <div class="install-text" data-slide="left">
      <SectionHead name="Install" />
      <h2 id="install-title" class="h-section">Three lines, <span class="accent">no cookies.</span></h2>
      <div class="collapsible">
        <p class="clip">
          Add one script tag to the pages you want to adapt. Mark the sections it may reorder, write or describe your
          variants, and every visitor gets the default page until there is a clear reason to change it.
        </p>
        <button type="button" class="more-btn" aria-expanded="false">Read more</button>
      </div>
      <dl class="facts">
        <div><dt class="mono">Size</dt><dd>4 kB</dd></div>
        <div><dt class="mono">Cookies</dt><dd>None</dd></div>
        <div><dt class="mono">Works with</dt><dd>Any site</dd></div>
      </dl>
    </div>

    <div class="code" data-signal="code" data-slide="right">
      <div class="code-bar">
        <div role="tablist" aria-label="Install snippet">
          {
            tabs.map((t, i) => (
              <button
                type="button"
                role="tab"
                id={`tab-${t.id}`}
                aria-controls={`panel-${t.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                data-install-tab>
                {t.name}
              </button>
            ))
          }
        </div>
        <button type="button" class="copy" data-copy="code-html"><Icon name="lucide:copy" aria-hidden="true" /><span data-copy-label>Copy</span></button>
      </div>
      {
        tabs.map((t, i) => (
          <div role="tabpanel" id={`panel-${t.id}`} aria-labelledby={`tab-${t.id}`} hidden={i !== 0} tabindex="0">
            <pre><code id={`code-${t.id}`} data-snippet={i === 0 ? '' : undefined}>{t.code}</code></pre>
          </div>
        ))
      }
      <div class="expand-builder code-more">
        <p class="mono code-note">// what the snippet does</p>
        <ol>
          <li><span class="mono">01</span> Loads after your page renders, so the first paint is always the default page.</li>
          <li><span class="mono">02</span> Reads signals in memory only. No cookies, no storage, no network calls with visitor data.</li>
          <li><span class="mono">03</span> Applies a shape only to elements you mark with <code>data-shapewell</code>.</li>
        </ol>
      </div>
      <p class="code-foot mono">Demo snippet. The address is a placeholder until early access opens.</p>
    </div>
  </div>
</section>

<style>
  .install {
    align-items: start;
    row-gap: 40px;
  }
  .install-text {
    grid-column: 1 / span 5;
    display: grid;
    gap: 22px;
  }
  .install-text .section-head {
    margin-bottom: 0;
  }
  .collapsible p {
    margin: 0;
  }
  .facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--hairline);
  }
  .facts div {
    padding: 14px 12px 0 0;
  }
  .facts dt {
    font-size: 11px;
    color: var(--slate);
  }
  .facts dd {
    margin: 4px 0 0;
    font-family: var(--f-head);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 24px;
    line-height: 1;
  }
  .code {
    grid-column: 7 / span 6;
    background: var(--graphite);
    color: var(--paper);
    border-radius: 2px;
    min-width: 0;
  }
  .code-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    border-bottom: 1px solid rgb(245 244 240 / 0.14);
    padding: 0 8px 0 0;
  }
  [role='tablist'] {
    display: flex;
    overflow-x: auto;
  }
  [role='tab'] {
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    color: #b9bbc2;
    font-family: var(--f-mono);
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 14px 16px 12px;
    cursor: pointer;
    white-space: nowrap;
  }
  [role='tab'][aria-selected='true'] {
    color: var(--paper);
    border-bottom-color: var(--cobalt);
  }
  [role='tab']:focus-visible,
  .copy:focus-visible,
  [role='tabpanel']:focus-visible {
    outline-color: var(--paper);
    outline-offset: -2px;
  }
  .copy {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 6px 12px;
    background: none;
    border: 1px solid rgb(245 244 240 / 0.3);
    border-radius: 2px;
    color: var(--paper);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    flex-shrink: 0;
  }
  .copy:hover {
    border-color: var(--paper);
  }
  .copy svg {
    width: 16px;
    height: 16px;
  }
  pre {
    margin: 0;
    padding: 24px 20px;
    overflow-x: auto;
    font-family: var(--f-mono);
    font-weight: 500;
    font-size: 14px;
    line-height: 1.7;
  }
  .code-more {
    padding: 0 20px 8px;
    border-top: 1px solid rgb(245 244 240 / 0.14);
  }
  .code-note {
    color: #b9bbc2;
    font-size: 11px;
    margin: 16px 0 8px;
  }
  .code-more ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .code-more li {
    display: grid;
    grid-template-columns: 32px 1fr;
    font-size: 14px;
    line-height: 1.5;
    padding: 8px 0;
  }
  .code-more li .mono {
    color: #8fa0ff;
    font-size: 11px;
    padding-top: 3px;
  }
  .code-more code {
    font-family: var(--f-mono);
    font-size: 13px;
  }
  .code-foot {
    margin: 0;
    padding: 12px 20px;
    border-top: 1px solid rgb(245 244 240 / 0.14);
    color: #b9bbc2;
    font-size: 10px;
    max-width: none;
  }
  @media (max-width: 900px) {
    .install-text,
    .code {
      grid-column: 1 / -1;
    }
  }
</style>
