---
import { Icon } from 'astro-icon/components';
const items = [
  { icon: 'logos:cloudflare-icon', name: 'Cloudflare', note: 'Static hosting' },
  { icon: 'logos:astro-icon', name: 'Astro', note: 'Pages and routing' },
  { icon: 'logos:gsap', name: 'GSAP', note: 'Flip, ScrollTrigger' },
  { icon: 'logos:chrome', name: 'Web platform', note: 'IntersectionObserver, localStorage' },
];
---

<section class="built" aria-label="Built with">
  <div class="container built-inner">
    <p class="label label-sm"><span class="c">Built with</span> / the real stack of this page</p>
    <ul>
      {
        items.map((it) => (
          <li data-slide="up">
            <Icon name={it.icon} aria-hidden="true" />
            <span>
              <strong>{it.name}</strong>
              <span class="muted">{it.note}</span>
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .built {
    border-block: 1px solid var(--hairline);
    background: var(--white);
  }
  .built-inner {
    display: flex;
    align-items: center;
    gap: 32px;
    padding-block: 22px;
    flex-wrap: wrap;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    flex: 1;
  }
  li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    line-height: 1.3;
  }
  li > span {
    display: grid;
  }
  li :global(svg) {
    width: 28px;
    height: 28px;
  }
  .muted {
    font-size: 12px;
  }
</style>
