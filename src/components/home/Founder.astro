---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SectionHead from '../SectionHead.astro';

// Drop your photo at src/assets/images/founder.jpg and it is picked up automatically.
const found = import.meta.glob<{ default: ImageMetadata }>('../../assets/images/founder.jpg', { eager: true });
const photo = Object.values(found)[0]?.default;
const name = '[Your name]';
const initials = 'YN';
---

<section class="section" id="founder" aria-labelledby="founder-title">
  <div class="container grid-12 founder">
    <div class="founder-text" data-slide="left">
      <SectionHead name="Founder" />
      <h2 id="founder-title" class="h-section">Built by someone tired of <span class="accent">average pages.</span></h2>
      <div class="who">
        <p class="name">{name}</p>
        <p class="label label-sm"><span class="c">[Your role]</span></p>
      </div>
      <p>[Your story: first sentence, why you started Shapewell.] [Your story: second sentence, what you want it to change.]</p>
      <a class="link" href="#">LinkedIn</a>
    </div>
    <figure class="frame founder-photo" data-slide="right">
      <div class="frame-media">
        {
          photo ? (
            <Picture src={photo} alt={`Portrait of ${name}`} widths={[360, 560, 760]} sizes="(max-width: 900px) 100vw, 420px" formats={['avif', 'webp']} />
          ) : (
            <div class="initials" role="img" aria-label="Founder photo placeholder">
              <span>{initials}</span>
            </div>
          )
        }
      </div>
      <figcaption>Fig. 04 - The founder</figcaption>
    </figure>
  </div>
</section>

<style>
  .founder {
    align-items: center;
    row-gap: 40px;
  }
  .founder-text {
    grid-column: 1 / span 6;
    display: grid;
    gap: 20px;
    justify-items: start;
  }
  .founder-text .section-head {
    margin-bottom: 0;
    width: 100%;
  }
  .founder-text p {
    margin: 0;
  }
  .who {
    display: grid;
    gap: 4px;
  }
  .name {
    font-size: 22px;
    font-weight: 600;
  }
  .founder-photo {
    grid-column: 8 / span 4;
  }
  .frame-media {
    aspect-ratio: 1 / 1;
  }
  .initials {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    background: var(--paper);
    border: 1px dashed var(--hairline);
  }
  .initials span {
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 96px;
    color: var(--cobalt);
    line-height: 1;
  }
  @media (max-width: 900px) {
    .founder-text,
    .founder-photo {
      grid-column: 1 / -1;
    }
    .founder-photo {
      max-width: 420px;
    }
  }
</style>
