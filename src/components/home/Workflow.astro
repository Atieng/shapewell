---
import Frame from '../Frame.astro';
import SectionHead from '../SectionHead.astro';
import s1 from '../../assets/images/step-1.jpg';
import s2 from '../../assets/images/step-2.jpg';
import s3 from '../../assets/images/step-3.jpg';

const steps = [
  {
    n: '01',
    name: 'Observe',
    img: s1,
    alt: 'A person gesturing while a colleague reads from a laptop',
    text: 'The script reads a few behaviour signals in the browser: how fast you scroll, where you pause, what you hover and click.',
    slide: 'left',
  },
  {
    n: '02',
    name: 'Decide',
    img: s2,
    alt: 'A team in a bright office planning with sticky notes on a whiteboard',
    text: 'Every two seconds it scores three reading profiles. It only acts when one leads by 25 %, and then holds for 20 seconds.',
    slide: 'up',
  },
  {
    n: '03',
    name: 'Reshape',
    img: s3,
    alt: 'A person in a purple sweater using a tablet with a keyboard',
    text: 'The page changes its sub-headline, section order, layout and main button, with a plain reason for each change.',
    slide: 'right',
  },
] as const;
---

<section class="section" id="how" aria-labelledby="how-title">
  <div class="container">
    <SectionHead name="Workflow" />
    <h2 id="how-title" class="h-section">From one page for everyone to <span class="accent">one page for each person.</span></h2>
    <ol class="steps">
      {
        steps.map((s) => (
          <li data-slide={s.slide}>
            <Frame src={s.img} alt={s.alt} ratio="3 / 2" sizes="(max-width: 860px) 100vw, 380px" widths={[360, 560, 760]} />
            <span class="label"><span class="c">{s.n}</span> / {s.name}</span>
            <p>{s.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .h-section {
    margin-bottom: 48px;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .steps li {
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .steps p {
    margin: 0;
  }
  @media (max-width: 860px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
