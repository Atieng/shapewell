---
// Hairline + numbered mono label, e.g. "01 / The average visitor doesn't exist".
interface Props {
  name: string;
  n: number;
  class?: string;
}
const { name, n, class: cls = '' } = Astro.props;
---

<div class:list={['section-head', cls]}>
  <span class="label" data-type><span class="c">{String(n).padStart(2, '0')}</span> / {name}</span>
</div>
