---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';

const home = Astro.url.pathname === '/';
const h = (id: string) => (home ? `#${id}` : `/#${id}`);
const links = [
  { href: h('how'), label: 'How it works' },
  { href: h('use-cases'), label: 'Use cases' },
  { href: h('pricing'), label: 'Pricing' },
  { href: h('faq'), label: 'FAQ' },
  { href: h('founder'), label: 'Founder' },
  { href: '/library', label: 'Your experiments' },
];
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <Logo size={32} />
    <nav class="nav-links" aria-label="Main">
      <ul>
        {links.map((l) => <li><a href={l.href} aria-current={Astro.url.pathname === l.href ? 'page' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="nav-actions">
      <button type="button" class="btn btn-primary btn-sm" data-open-studio aria-controls="studio" aria-expanded="false" aria-keyshortcuts="K">
        <span class="hide-sm">Open </span><span class="cap-sm">studio</span> <span class="kbd" aria-hidden="true">K</span>
      </button>
      <button type="button" class="menu-btn" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="lucide:menu" class="i-open" aria-hidden="true" />
        <Icon name="lucide:x" class="i-close" aria-hidden="true" />
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav class="container" aria-label="Mobile">
      <ul>
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }
  .nav:global(.is-scrolled) {
    background: rgb(245 244 240 / 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--hairline);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav-links ul {
    display: flex;
    gap: 26px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    color: var(--graphite);
    padding: 6px 0;
    border-bottom: 1px solid transparent;
  }
  .nav-links a:hover,
  .nav-links a[aria-current='page'] {
    border-bottom-color: var(--cobalt);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: 2px;
    cursor: pointer;
  }
  .menu-btn svg {
    width: 20px;
    height: 20px;
  }
  .menu-btn .i-close,
  .menu-btn[aria-expanded='true'] .i-open {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .i-close {
    display: block;
  }
  .mobile-menu {
    background: var(--paper);
    border-bottom: 1px solid var(--hairline);
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 8px 0 16px;
  }
  .mobile-menu a {
    display: block;
    padding: 12px 0;
    border-bottom: 1px solid var(--hairline);
    text-decoration: none;
    font-weight: 500;
  }
  @media (max-width: 1020px) {
    .nav-links {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (max-width: 480px) {
    .nav-actions .btn .kbd {
      display: none;
    }
    .nav-actions .btn {
      padding-inline: 14px;
      white-space: nowrap;
    }
    .hide-sm {
      display: none;
    }
    .cap-sm {
      text-transform: capitalize;
    }
  }
  @media (min-width: 1021px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
