---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';

const join = Astro.url.pathname === '/' ? '#early-access' : '/#early-access';
---

<header class="nav" data-nav>
  <div class="container nav-inner">
    <Logo size={32} />
    <div class="nav-actions">
      <button type="button" class="btn btn-sm hide-mobile" data-open-why aria-controls="why-panel" aria-expanded="false">See why it changed</button>
      <a class="btn btn-primary btn-sm hide-mobile" href={join}>Join early access</a>
      <button type="button" class="menu-btn" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
        <Icon name="lucide:menu" class="i-open" aria-hidden="true" />
        <Icon name="lucide:x" class="i-close" aria-hidden="true" />
        <span class="sr-only">Menu</span>
      </button>
    </div>
  </div>
  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav class="container" aria-label="Mobile">
      <ul>
        <li><button type="button" data-open-why aria-controls="why-panel" aria-expanded="false">See why it changed</button></li>
        <li><a href={join}>Join early access</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--nav-h);
    border-bottom: 1px solid transparent;
    transition:
      background-color 0.25s ease,
      border-color 0.25s ease;
  }
  .nav:global(.is-scrolled) {
    background: rgb(245 244 240 / 0.82);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--hairline);
  }
  .nav-inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .menu-btn {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    background: var(--white);
    border: 1px solid var(--hairline);
    border-radius: 2px;
    cursor: pointer;
  }
  .menu-btn svg {
    width: 20px;
    height: 20px;
  }
  .menu-btn .i-close,
  .menu-btn[aria-expanded='true'] .i-open {
    display: none;
  }
  .menu-btn[aria-expanded='true'] .i-close {
    display: block;
  }
  .mobile-menu {
    background: var(--paper);
    border-bottom: 1px solid var(--hairline);
  }
  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 8px 0 16px;
  }
  .mobile-menu a,
  .mobile-menu button {
    display: block;
    width: 100%;
    padding: 12px 0;
    background: none;
    border: 0;
    border-bottom: 1px solid var(--hairline);
    text-align: left;
    text-decoration: none;
    font: inherit;
    font-weight: 500;
    color: var(--graphite);
    cursor: pointer;
  }
  @media (max-width: 640px) {
    .hide-mobile {
      display: none;
    }
    .menu-btn {
      display: inline-flex;
    }
  }
  @media (min-width: 641px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
