---
import Logo from './Logo.astro';
---

<footer class="footer">
  <div class="container footer-inner">
    <div class="brand">
      <Logo size={28} tone="light" />
      <p>One page, shaped for every reader.</p>
    </div>
    <div class="footer-bottom">
      <span>(c) 2026 Shapewell</span>
      <a href="/privacy">Privacy</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--graphite);
    color: var(--paper);
    padding: 56px 0 32px;
    overflow-x: clip;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .brand p {
    color: #b9bbc2;
    margin: 14px 0 0;
    font-size: 15px;
  }
  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    font-size: 14px;
    color: #b9bbc2;
  }
  a {
    color: var(--paper);
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  :focus-visible {
    outline-color: var(--paper);
  }
</style>
