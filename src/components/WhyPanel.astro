---
import { Icon } from 'astro-icon/components';
import Logo from './Logo.astro';
import VibeBox from './VibeBox.astro';
---

<div id="why-backdrop" class="why-backdrop" hidden></div>
<div id="why-panel" class="why-panel" role="dialog" aria-modal="true" aria-labelledby="why-title" hidden>
  <header class="panel-head">
    <div class="panel-brand">
      <Logo size={28} wordmark={false} href={null} />
      <div>
        <h2 id="why-title" class="panel-title">Why this page changed</h2>
        <p class="label label-sm"><span class="c" data-engine-status>Watching</span></p>
      </div>
    </div>
    <button type="button" class="panel-x" data-close-why aria-label="Close (Esc)">
      <Icon name="lucide:x" aria-hidden="true" />
    </button>
  </header>

  <div class="panel-body">
    <p class="panel-privacy" data-privacy-note hidden>
      Your browser sends Do Not Track or Global Privacy Control, so adapting is paused. You can still turn it on below or replay a profile.
    </p>

    <section class="panel-block" aria-labelledby="wp-now">
      <div class="panel-row">
        <h3 id="wp-now" class="label"><span class="c">Current shape</span></h3>
        <div class="switch-wrap">
          <span id="wp-pause-label" class="switch-text">Pause adapting</span>
          <button type="button" role="switch" class="switch" aria-checked="false" aria-labelledby="wp-pause-label" data-pause><span></span></button>
        </div>
      </div>
      <p class="panel-profile" data-current-profile>Default</p>
    </section>

    <section class="panel-block" aria-labelledby="wp-why">
      <h3 id="wp-why" class="label"><span class="c">Reasons</span> / in plain words</h3>
      <ul class="why" data-reasons aria-live="polite"></ul>
    </section>

    <section class="panel-block" aria-labelledby="wp-signals">
      <h3 id="wp-signals" class="label"><span class="c">Live signals</span> / in memory only</h3>
      <div class="meters" data-meters></div>
    </section>

    <section class="panel-block" aria-labelledby="wp-scores">
      <h3 id="wp-scores" class="label"><span class="c">Profile scores</span> / leader needs +25 %</h3>
      <div class="meters" data-scores></div>
    </section>

    <section class="panel-block" aria-labelledby="wp-replay">
      <h3 id="wp-replay" class="label"><span class="c">Replay as</span></h3>
      <div class="replay">
        <button type="button" class="btn btn-sm" data-replay="builder" aria-pressed="false">Builder</button>
        <button type="button" class="btn btn-sm" data-replay="buyer" aria-pressed="false">Buyer</button>
        <button type="button" class="btn btn-sm" data-replay="researcher" aria-pressed="false">Researcher</button>
      </div>
      <div class="btn-row panel-actions">
        <button type="button" class="btn btn-sm btn-ghost" data-reset><Icon name="lucide:rotate-ccw" aria-hidden="true" />Reset to default</button>
        <button type="button" class="btn btn-sm btn-primary" data-save-run><Icon name="lucide:save" aria-hidden="true" />Save this run</button>
      </div>
      <p class="save-status" data-save-status role="status" aria-live="polite"></p>
    </section>

    <section class="panel-block" aria-labelledby="wp-vibe">
      <h3 id="wp-vibe" class="label"><span class="c">Describe a variant</span> / plain English in</h3>
      <VibeBox id="panel-vibe" compact />
    </section>

    <section class="panel-block" aria-labelledby="wp-saved">
      <div class="panel-row">
        <h3 id="wp-saved" class="label"><span class="c">Saved</span> / this device only</h3>
        <button type="button" class="btn btn-sm btn-ghost" data-saved-all hidden><Icon name="lucide:download" aria-hidden="true" />Download all</button>
      </div>
      <p class="saved-empty muted" data-saved-empty>Nothing saved yet. Use "Save this run" or "Save variant" and it shows up here.</p>
      <ul class="saved" data-saved-list></ul>
      <p class="save-status" data-saved-status role="status" aria-live="polite"></p>
    </section>
  </div>
</div>

<style>
  .why-backdrop {
    position: fixed;
    inset: 0;
    z-index: 70;
    background: rgb(22 24 29 / 0.32);
  }
  .why-panel {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 80;
    width: min(440px, 100vw);
    display: flex;
    flex-direction: column;
    background: var(--white);
    border-left: 1px solid var(--hairline);
    transform: translateX(100%);
    transition: transform 0.38s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .why-panel[hidden] {
    display: none;
  }
  .why-panel:global(.is-open) {
    transform: none;
  }
  @media (max-width: 640px) {
    .why-panel {
      top: auto;
      left: 0;
      width: 100%;
      height: 88vh;
      height: 88dvh;
      border-left: 0;
      border-top: 1px solid var(--hairline);
      transform: translateY(100%);
    }
  }
  .panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--hairline);
  }
  .panel-brand {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .panel-brand p {
    margin: 0;
  }
  .panel-title {
    font-family: var(--f-head);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 20px;
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .panel-x {
    width: 44px;
    height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid var(--hairline);
    border-radius: 2px;
    cursor: pointer;
  }
  .panel-x:hover {
    border-color: var(--graphite);
  }
  .panel-x svg {
    width: 20px;
    height: 20px;
  }
  .panel-body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px 20px 32px;
  }
  .panel-privacy {
    margin: 16px 0 0;
    padding: 12px 14px;
    border: 1px solid var(--cobalt);
    font-size: 14px;
    line-height: 1.5;
  }
  .panel-block {
    padding: 18px 0;
    border-bottom: 1px solid var(--hairline);
  }
  .panel-block:last-child {
    border-bottom: 0;
  }
  .panel-block h3 {
    margin-bottom: 12px;
    font-size: 11px;
  }
  .panel-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .panel-row h3 {
    margin: 0;
  }
  .panel-profile {
    margin: 10px 0 0;
    font-family: var(--f-head);
    font-weight: 800;
    font-size: 30px;
    text-transform: uppercase;
    line-height: 1;
    color: var(--cobalt);
  }
  .switch-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .switch-text {
    font-size: 14px;
  }
  .switch {
    position: relative;
    width: 44px;
    height: 24px;
    border: 1px solid var(--graphite);
    border-radius: 2px;
    background: var(--white);
    cursor: pointer;
    padding: 0;
  }
  .switch span {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 16px;
    height: 16px;
    background: var(--graphite);
    transition: transform 0.2s ease;
  }
  .switch[aria-checked='true'] {
    background: var(--cobalt);
    border-color: var(--cobalt);
  }
  .switch[aria-checked='true'] span {
    transform: translateX(20px);
    background: var(--white);
  }
  .why {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 8px;
  }
  .why :global(li) {
    position: relative;
    padding-left: 18px;
    font-size: 14px;
    line-height: 1.5;
  }
  .why :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    width: 8px;
    height: 1px;
    background: var(--cobalt);
  }
  .replay {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  .replay .btn[aria-pressed='true'] {
    background: var(--cobalt);
    border-color: var(--cobalt);
    color: var(--white);
  }
  .panel-actions {
    margin-top: 12px;
  }
  .panel-actions .btn {
    flex: 1;
  }
  .save-status {
    margin: 10px 0 0;
    font-size: 13px;
    color: var(--slate);
  }
  .save-status:empty {
    display: none;
  }
  .saved {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 10px;
  }
  .saved-empty {
    margin: 0;
    font-size: 14px;
  }
  .saved-empty[hidden] {
    display: none;
  }
  .saved :global(.saved-item) {
    border: 1px solid var(--hairline);
    padding: 12px;
    display: grid;
    gap: 10px;
  }
  .saved :global(p) {
    margin: 0;
  }
  .saved :global(.saved-title) {
    font-weight: 600;
    font-size: 14px;
  }
  .saved :global(.saved-meta) {
    font-size: 11px;
    color: var(--slate);
  }
  .saved :global(.saved-detail) {
    font-size: 13px;
    line-height: 1.5;
    color: var(--slate);
  }
  .saved :global(.saved-actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .panel-title {
    font-size: 18px;
  }
</style>
