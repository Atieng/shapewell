---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
---

<Base
  title="Your experiments: saved runs and variants | Shapewell"
  description="The runs and vibe-coded variants you saved in the Shapewell studio. Stored only in this browser. Restore, delete or download them as JSON.">
  <section class="section lib" aria-labelledby="lib-title">
    <div class="container">
      <SectionHead name="Library" />
      <div class="lib-head">
        <div data-slide="left">
          <h1 id="lib-title" class="h-display">Your <span class="accent">experiments.</span></h1>
          <p class="muted">Saved runs and variants live in this browser only, under the key <code>shapewell_runs</code>. Nobody else can see them.</p>
        </div>
        <div class="btn-row" data-slide="right">
          <button type="button" class="btn" data-download-all disabled><Icon name="lucide:download" aria-hidden="true" />Download all as JSON</button>
          <button type="button" class="btn btn-primary" data-open-studio aria-controls="studio" aria-expanded="false">Open studio <span class="kbd" aria-hidden="true">K</span></button>
        </div>
      </div>

      <p class="storage-note" data-storage-note hidden>
        Your browser blocks storage, so saved items last only until you leave or reload this page.
      </p>

      <div class="undo" data-undo hidden role="status" aria-live="polite">
        <span data-undo-text>Deleted.</span>
        <button type="button" class="btn btn-sm" data-undo-btn>Restore</button>
      </div>

      <ul class="entries" data-entries aria-label="Saved items"></ul>

      <div class="empty" data-empty hidden>
        <Icon name="lucide:flask-conical" aria-hidden="true" />
        <h2 class="h-card">Nothing saved yet</h2>
        <p>Read the home page for a little while, open the studio and press "Save this run". Or describe a variant and save it. It will show up here.</p>
        <div class="btn-row">
          <button type="button" class="btn btn-primary" data-open-studio aria-controls="studio" aria-expanded="false">Open the studio</button>
          <a class="btn" href="/#variants">Describe a variant</a>
        </div>
      </div>

      <noscript><p>The library needs JavaScript because it reads from your browser's storage.</p></noscript>
    </div>
  </section>
</Base>

<script>
  import { list, remove, restore, download, storageAvailable, type Entry } from '../scripts/library';

  const NAMES: Record<string, string> = {
    default: 'Default',
    builder: 'Builder',
    buyer: 'Buyer',
    researcher: 'Researcher',
    mobile: 'Mobile-short',
  };
  let undoTimer: number | undefined;
  let lastDeleted: Entry | null = null;

  const esc = (s: string) =>
    s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);

  function fmtDate(iso: string) {
    try {
      return new Intl.DateTimeFormat('en', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(iso));
    } catch {
      return iso;
    }
  }

  function summaryLine(e: Entry) {
    if (e.kind === 'variant') return esc(`"${e.prompt}"`);
    const s = e.summary as Record<string, any>;
    const d = s.dwellSeconds || {};
    const h = s.hoverSeconds || {};
    return esc(
      `${s.seconds ?? 0} s on ${e.page}. Scroll ${s.scrollSpeed ?? 0} px/s, depth ${s.maxDepth ?? 0} %. ` +
        `Code ${h.code ?? 0} s hover, pricing ${h.pricing ?? 0} s hover, reading ${((d.explain ?? 0) + (d.faq ?? 0) + (d.limits ?? 0)).toFixed(1)} s. ` +
        `Billing toggle ${s.billingToggles ?? 0}x. ${s.device === 'touch' ? 'Touch' : 'Mouse'}.`,
    );
  }

  function detail(e: Entry) {
    if (e.kind === 'variant') {
      return `<dl class="rule-mini">
        <div><dt class="mono">When</dt><dd>${esc(e.rule.when)}</dd></div>
        <div><dt class="mono">Show</dt><dd>${esc(e.rule.show)}</dd></div>
        <div><dt class="mono">Copy</dt><dd>${esc(e.rule.copy)}</dd></div>
        <div><dt class="mono">Button</dt><dd>${esc(e.rule.button)}</dd></div>
      </dl>`;
    }
    return `<ul class="reasons">${e.reasons.map((r) => `<li>${esc(r)}</li>`).join('')}</ul>`;
  }

  function render() {
    const root = document.querySelector<HTMLElement>('[data-entries]');
    if (!root) return;
    const items = list();
    document.querySelector<HTMLElement>('[data-empty]')!.hidden = items.length > 0;
    document.querySelector<HTMLButtonElement>('[data-download-all]')!.disabled = items.length === 0;
    document.querySelector<HTMLElement>('[data-storage-note]')!.hidden = storageAvailable();
    root.innerHTML = items
      .map(
        (e) => `<li class="entry">
          <div class="entry-top">
            <span class="label label-sm"><span class="c">${e.kind === 'run' ? 'Run' : 'Variant'}</span> / ${esc(NAMES[e.profile] || e.profile)}</span>
            <time class="mono" datetime="${esc(e.date)}">${esc(fmtDate(e.date))}</time>
          </div>
          <p class="entry-sum">${summaryLine(e)}</p>
          <details><summary>${e.kind === 'run' ? 'Why it changed' : 'Generated rule'}</summary>${detail(e)}</details>
          <div class="btn-row">
            <button type="button" class="btn btn-sm" data-dl="${esc(e.id)}">Download as JSON</button>
            <button type="button" class="btn btn-sm btn-ghost" data-del="${esc(e.id)}">Delete</button>
          </div>
        </li>`,
      )
      .join('');
  }

  function showUndo(e: Entry) {
    lastDeleted = e;
    const bar = document.querySelector<HTMLElement>('[data-undo]')!;
    bar.querySelector('[data-undo-text]')!.textContent = `Deleted the ${e.kind} from ${fmtDate(e.date)}. You can restore it for 10 seconds.`;
    bar.hidden = false;
    clearTimeout(undoTimer);
    undoTimer = window.setTimeout(() => {
      bar.hidden = true;
      lastDeleted = null;
    }, 10000);
  }

  function init() {
    const root = document.querySelector<HTMLElement>('[data-entries]');
    if (!root) return;
    render();
    root.addEventListener('click', (ev) => {
      const t = ev.target as HTMLElement;
      const del = t.closest<HTMLElement>('[data-del]');
      const dl = t.closest<HTMLElement>('[data-dl]');
      if (del) {
        const gone = remove(del.dataset.del!);
        render();
        if (gone) showUndo(gone);
        document.querySelector<HTMLElement>('[data-undo-btn]')?.focus();
      } else if (dl) {
        const e = list().find((x) => x.id === dl.dataset.dl);
        if (e) download([e], `shapewell-${e.kind}-${e.id}.json`);
      }
    });
    document.querySelector('[data-undo-btn]')?.addEventListener('click', () => {
      if (!lastDeleted) return;
      restore(lastDeleted);
      lastDeleted = null;
      clearTimeout(undoTimer);
      document.querySelector<HTMLElement>('[data-undo]')!.hidden = true;
      render();
    });
    document.querySelector('[data-download-all]')?.addEventListener('click', () => download());
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('shapewell:library', render);
</script>

<style>
  .lib {
    min-height: 70vh;
  }
  .lib-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 24px;
    margin-bottom: 40px;
  }
  .lib-head p {
    margin: 16px 0 0;
  }
  code {
    font-family: var(--f-mono);
    font-size: 13px;
  }
  .storage-note,
  .undo {
    border: 1px solid var(--cobalt);
    background: var(--white);
    padding: 12px 16px;
    margin: 0 0 20px;
    max-width: none;
  }
  .undo:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }
  .entries :global(.entry) {
    background: var(--white);
    border: 1px solid var(--hairline);
    padding: 22px;
    display: grid;
    gap: 14px;
    align-content: start;
  }
  .entries :global(.entry-top) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .entries :global(time) {
    font-size: 11px;
    color: var(--slate);
  }
  .entries :global(.entry-sum) {
    margin: 0;
  }
  .entries :global(summary) {
    cursor: pointer;
    font-weight: 600;
    padding: 6px 0;
  }
  .entries :global(.reasons) {
    margin: 8px 0 0;
    padding-left: 18px;
    font-size: 14px;
  }
  .entries :global(.rule-mini) {
    margin: 8px 0 0;
    font-size: 14px;
  }
  .entries :global(.rule-mini div) {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 10px;
    padding: 6px 0;
    border-top: 1px solid var(--hairline);
  }
  .entries :global(.rule-mini dt) {
    font-size: 10px;
    color: var(--cobalt);
    padding-top: 3px;
  }
  .entries :global(.rule-mini dd) {
    margin: 0;
  }
  .empty {
    border: 1px dashed var(--hairline);
    background: var(--white);
    padding: 48px 28px;
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .empty svg {
    width: 32px;
    height: 32px;
    color: var(--cobalt);
  }
  .empty p {
    margin: 0;
  }
  @media (max-width: 760px) {
    .entries {
      grid-template-columns: 1fr;
    }
  }
</style>
